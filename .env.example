# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=optional_guild_id_for_faster_command_registration

# Groq API Keys (provide 1–4 keys, comma-separated)
# Get free keys at https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4

# Preferred Groq model (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/discord-ai-bot
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/discord-ai-bot

# Bot behaviour
MAX_MEMORY_MESSAGES=20
OWNER_IDS=123456789012345678,987654321098765432
